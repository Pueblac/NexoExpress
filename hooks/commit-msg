#!/bin/sh
# Git commit-msg hook
# Este script intercepta el mensaje del commit antes de crearlo.
# Si detecta palabras relacionadas a IA, bloquea el commit automáticamente.

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Limpiar el mensaje de comentarios de git (líneas que empiezan con #) y líneas vacías
clean_msg=$(grep -v '^#' "$commit_msg_file" | awk 'NF')
line_count=$(echo "$clean_msg" | wc -l)
char_count=$(echo "$clean_msg" | wc -m)

# 1. Validación de longitud: máximo 1 línea
if [ "$line_count" -gt 1 ]; then
    echo ""
    echo "======================================================================"
    echo " ALERTA: COMMIT BLOQUEADO"
    echo "======================================================================"
    echo "Los commits deben ser de una sola línea."
    echo "Tu mensaje actual tiene $line_count líneas."
    echo "Ejemplo: git commit -m 'fix: corregir guardado de timestamp en minio'"
    echo "======================================================================"
    exit 1
fi

# Lista de palabras prohibidas (se añadieron modelos y herramientas recientes como deepseek, perplexity, grok, llama, qwen)
forbidden_words="\b(ia|ai|agente|agentes|workflow|workflows|prompt|chatgpt|gemini|llm|copilot|claude|anthropic|gpt|openai|mistral|cohere|bard|deepseek|perplexity|grok|llama|qwen|phind|xai|huggingface|midjourney|noreply@anthropic|co-authored-by.*claude|co-authored-by.*anthropic|inteligencia artificial|machine learning|generado por|generated by|auto-generated)\b"

# 2. Verificamos si alguna palabra está en el mensaje
if echo "$clean_msg" | grep -iqE "$forbidden_words"; then
    echo ""
    echo "======================================================================"
    echo " ALERTA: COMMIT BLOQUEADO (HUELLA DE IA DETECTADA) "
    echo "======================================================================"
    echo "Tu mensaje de commit podría estar haciendo referencia al uso de Inteligencia Artificial."
    echo ""
    echo "Tu mensaje fue:"
    echo "--------------------------------------------------"
    echo "$clean_msg"
    echo "--------------------------------------------------"
    echo ""
    echo "Por favor, intenta nuevamente con un mensaje puramente corporativo."
    echo "Ejemplo: git commit -m 'docs: actualizar manual de arquitectura'"
    echo "======================================================================"
    exit 1
fi

# Si todo está bien, permitimos el commit
exit 0
